{
  "name": "spire-ui-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "registry:build": "shadcn build -o apps/docs/public/r",
    "storybook": "bun run --cwd apps/storybook dev",
    "storybook:build": "bun run --cwd apps/storybook build",
    "typecheck": "tsc -p . && tsc -p packages/cli && tsc -p apps/docs",
    "docs:build": "bun run registry:build && bun run storybook:build && bun run --cwd apps/docs build",
    "docs:preview": "bun run --cwd apps/docs preview",
    "docs:e2e": "bun run --cwd apps/docs e2e",
    "consumer:smoke": "bun run --cwd apps/consumer-smoke smoke"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "clsx": "^2.1.1",
    "happy-dom": "^21.0.4",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "radix-ui": "^1.8.1",
    "react": "^19",
    "react-dom": "^19"
  },
  "packageManager": "bun@1.3.13"
}
