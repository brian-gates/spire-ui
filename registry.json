{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "spire-ui",
  "homepage": "https://brian-gates.github.io/spire-ui/",
  "items": [
    {
      "name": "spire-theme",
      "type": "registry:theme",
      "title": "Spire theme",
      "description": "Dark slate-teal palette, class and rarity colours, fonts, and panel/frame utilities.",
      "files": [
        {
          "path": "registry/spire/theme/spire.css",
          "type": "registry:theme",
          "target": "~/styles/spire.css"
        }
      ],
      "cssVars": {
        "theme": {
          "color-spire-bg": "#0a1115",
          "color-spire-panel": "#18262d",
          "color-spire-panel-edge": "#3b5560",
          "color-spire-ink": "#f3e9d2",
          "color-spire-muted": "#a9b8b8",
          "color-spire-gold": "#f0c75e",
          "color-spire-hp": "#ff8a7d",
          "color-spire-energy": "#5fb0e8",
          "color-class-ironclad": "#ec6a5e",
          "color-class-silent": "#6fbf68",
          "color-class-defect": "#5fb0e8",
          "color-class-regent": "#e8a944",
          "color-class-necrobinder": "#c49ae6",
          "color-rarity-common": "#a9b8b8",
          "color-rarity-uncommon": "#6fb8e0",
          "color-rarity-rare": "#f0c75e",
          "color-rarity-boss": "#ec6a5e",
          "color-rarity-event": "#6fbf68",
          "color-rarity-starter": "#8fa3a3",
          "font-spire-display": "\"Kreon\", Georgia, \"Iowan Old Style\", serif",
          "font-spire-body": "\"Spectral\", Georgia, \"Iowan Old Style\", serif"
        }
      }
    },
    {
      "name": "spire-utils",
      "type": "registry:lib",
      "title": "Spire utils",
      "description": "cn() class merging helper.",
      "dependencies": [
        "clsx",
        "tailwind-merge"
      ],
      "files": [
        {
          "path": "registry/spire/lib/cn.ts",
          "type": "registry:lib",
          "target": "~/lib/cn.ts"
        }
      ]
    },
    {
      "name": "spire-fallback-keys",
      "type": "registry:lib",
      "title": "Spire fallback keys",
      "description": "FallbackKey type and fallbackKeyFor() mapping game ids to fallback icon keys.",
      "files": [
        {
          "path": "registry/spire/icons/fallback-keys.ts",
          "type": "registry:lib",
          "target": "~/lib/spire/icons/fallback-keys.ts"
        }
      ]
    },
    {
      "name": "spire-assets",
      "type": "registry:lib",
      "title": "Spire assets",
      "description": "Manifest parser, id resolver and SpireAssets provider for locally extracted art.",
      "dependencies": [
        "react"
      ],
      "registryDependencies": [
        "https://brian-gates.github.io/spire-ui/r/spire-fallback-keys.json"
      ],
      "files": [
        {
          "path": "registry/spire/lib/assets.ts",
          "type": "registry:lib",
          "target": "~/lib/spire/lib/assets.ts"
        },
        {
          "path": "registry/spire/lib/assets-provider.tsx",
          "type": "registry:lib",
          "target": "~/lib/spire/lib/assets-provider.tsx"
        }
      ]
    }
  ]
}
