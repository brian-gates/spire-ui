          "rarity-rare": "#f0c75e",
          "rarity-boss": "#ec6a5e",
          "rarity-event": "#6fbf68",
          "rarity-starter": "#8fa3a3",
          "font-spire-display": "\"Kreon\", Georgia, \"Iowan Old Style\", serif",
          "font-spire-body": "\"Spectral\", Georgia, \"Iowan Old Style\", serif"
        }
      }
